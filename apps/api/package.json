{
  "name": "@retrowatchdog/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "worker": "tsx src/worker/index.ts"
  },
  "dependencies": {
    "@retrowatchdog/shared": "workspace:*",
    "bullmq": "^6.3.2",
    "cron-parser": "^5.10.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "undici": "^8.12.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
