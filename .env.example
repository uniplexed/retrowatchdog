# RetroWatchdog — root .env. Copy to `.env`; every value is optional.
#
#   cp .env.example .env
#
# The containers read this file through docker-compose.yml. A plugin's own
# settings and secrets never go here: they live in .env.<plugin> beside this
# file (.env.cex, .env.ebay, .env.vinted, .env.wallapop), documented in each plugin's own
# repository. Nothing in this file is ever committed (.gitignore).

# ---- Plugins to run --------------------------------------------------------
# Each RetroWatchdog plugin is a compose profile; list the ones to start. Their
# images default to the published ghcr.io/uniplexed/<name>:latest; pin a
# version or use a local build by setting the variable (for example set
# CEX_PLUGIN_IMAGE to retrowatchdog-cex-plugin:latest after `docker build` in
# its repository). The installer pins all five to the release it installs. API_IMAGE and WEB_IMAGE do the same for the app's own images.
# A plugin's own settings go in .env.<name> beside this file (.env.cex,
# .env.ebay, .env.vinted, .env.wallapop), never here.
# cex, vinted and wallapop are off by default: each has legal notes to read
# first (README, "About the sources, and the law"). eBay is an official API.
COMPOSE_PROFILES=ebay
# CEX_PLUGIN_IMAGE=
# EBAY_PLUGIN_IMAGE=
# VINTED_SIDECAR_PLUGIN_IMAGE=
# WALLAPOP_SIDECAR_PLUGIN_IMAGE=
# API_IMAGE=
# WEB_IMAGE=

# ---- HTTPS -----------------------------------------------------------------
# The name the web container answers HTTPS on: localhost, an IP or a bare
# host name (Caddy issues the certificate itself; clients trust
# https://<host>/root.crt once), or a real domain (Let's Encrypt, nothing to
# install). Several, comma-separated. Plain http:// keeps working for any host.
# PUBLIC_HOST=localhost

# ---- Network ---------------------------------------------------------------
# The plugins' own network. The api refuses every request from it, so a
# plugin cannot drive the app. Change it only if it collides with another
# network on this host.
# SIDECAR_SUBNET=172.31.250.0/24

# ---- Password ------------------------------------------------------------
# The app has no accounts. Set a bcrypt hash here and every request except
# /root.crt needs this user and password (HTTP basic auth, over HTTPS). Off
# while unset. Make the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your password'
# APP_USER=retro
# APP_PASSWORD_HASH=

# ---- Catalogue -------------------------------------------------------------
# IGDB (free, via dev.twitch.tv). Without them search only sees games already
# imported into the local catalogue.
IGDB_CLIENT_ID=
IGDB_SECRET=

# ---- Alerts ----------------------------------------------------------------
# Notifications for NEW watchlist signals through ntfy (https://ntfy.sh):
# subscribe a device to a topic, put the same name here and recreate the
# worker. OFF while unset — nothing is sent anywhere. On the public server
# anyone who guesses the topic can read it, so make the name long and random,
# or self-host ntfy and set NTFY_URL.
# NTFY_TOPIC=
# NTFY_URL=https://ntfy.sh

# ---- Markets ---------------------------------------------------------------
# Seed for the enabled-market list, comma-separated source ids. Applies only
# until Settings → Markets saves a list; from then on the stored row wins.
# Ids come from the approved plugins: cex, cex_es, cex_ie, ebay_uk, ebay_de,
# ebay_es, ebay_fr, ebay_us, vinted_uk.
# ENABLED_SOURCES=cex,ebay_uk

# Global price refresh policy: cached_auto (default) / live / cached_only.
# Per-title overrides live in the game screen.
# PRICE_MODE=cached_auto
# PRICE_TTL_HOURS=6

# ---- Plugins: what the APP holds every plugin to ---------------------------
# These live in the app, never in a plugin, so a plugin that forgot to pace
# itself still cannot make this deployment hammer anyone. A faster pace for
# one plugin is set in Settings → Plugins, per row, and beats the default.
# SIDECAR_RATE_LIMIT_MS=3000
# SIDECAR_BREAKER_THRESHOLD=5
# SIDECAR_BREAKER_HOLD_MS=1800000
# ADAPTER_TIMEOUT_MS=8000
# Bounds on one /search answer (bytes decoded, rows walked) and on how many of
# the surviving listings a median is taken over.
# SIDECAR_MAX_BYTES=8388608
# SIDECAR_MAX_LISTINGS=500
# SIDECAR_MEDIAN_WINDOW=50
# The same bounds for one catalogue page, plus a cap on pages per unit. A page
# over the row cap is refused, never truncated.
# SIDECAR_SYNC_MAX_ROWS_PER_PAGE=2000
# SIDECAR_SYNC_MAX_BYTES=16777216
# SIDECAR_SYNC_MAX_PAGES_PER_UNIT=100
# How often the worker polls every plugin's /health and /manifest. Keep it
# well above 2 × (plugins) × ADAPTER_TIMEOUT_MS.
# PLUGIN_HEALTH_INTERVAL_MS=300000

# Plugin addresses. docker-compose.yml sets these for the containers; set them
# here only for host-side dev servers that can reach a plugin. Each one offers
# its plugin as a pending row in Settings → Plugins, once per deployment.
# VINTED_SIDECAR_PLUGIN_URL=http://localhost:8000
# CEX_PLUGIN_URL=
# EBAY_PLUGIN_URL=
# WALLAPOP_SIDECAR_PLUGIN_URL=

# ---- Signal engine ---------------------------------------------------------
# SIGNAL_VOUCHER_FACTOR=1.15       # FLIP: bid > acquisition proxy × factor
# SIGNAL_OVERPRICED_FACTOR=1.3     # OVERPRICED_STORE: store > reference × factor
# SIGNAL_UNDERPRICED_FACTOR=0.7    # UNDERPRICED: listing < reference × factor
# SIGNAL_CROSS_STORE_FACTOR=0.85   # UNDERPRICED, pairwise across stores
# SIGNAL_PROFIT_FACTOR=1.15        # PROFIT: net sell reading > paid × factor
# SIGNAL_MIN_SAMPLE=5              # listings a median needs before it counts

# ---- Matching --------------------------------------------------------------
# MATCH_CONFIRM_THRESHOLD=0.6
# MATCH_REVIEW_THRESHOLD=0.35
# MIN_LOCAL_RESULTS=3
# LOCAL_SCORE_FLOOR=0.45
# MIN_ENRICH_QUERY_LENGTH=3
# PC_IMPORT_MATCH_THRESHOLD=0.45
# PC_IMPORT_REVIEW_THRESHOLD=0.25

# ---- Host-side dev only ----------------------------------------------------
# The containers get service-name URLs from docker-compose.yml, which override
# anything set here. These defaults point the pnpm dev servers at the
# published infra ports (docker compose up -d postgres redis).
# DATABASE_URL=postgres://retrowatchdog:retrowatchdog@localhost:5432/retrowatchdog
# REDIS_URL=redis://localhost:6379
# PORT=3001
# API_INTERNAL_URL=http://localhost:3001
